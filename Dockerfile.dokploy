FROM rust:1.95.0-bookworm AS wasm-tools
RUN rustup target add wasm32-unknown-unknown \
    && cargo install wasm-pack --version 0.14.0 --locked

FROM mirror.ccs.tencentyun.com/library/node:22-bookworm AS build
COPY --from=wasm-tools /usr/local/cargo /usr/local/cargo
COPY --from=wasm-tools /usr/local/rustup /usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup
ENV PATH="/usr/local/cargo/bin:${PATH}"
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY demo-app/package.json ./demo-app/package.json
COPY tests/package.json ./tests/package.json
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm prepare:wasm && DEMO_BASE_PATH=/waveform-analysis/ pnpm build:demo && git rev-parse HEAD > dist-demo/version.txt

FROM local/sub2api-cpa-converter:1bd8fb805d5d
USER root
RUN rm -rf /www
COPY --from=build /app/dist-demo /www
USER 65534:65534
