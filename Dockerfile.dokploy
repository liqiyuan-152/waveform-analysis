FROM mirror.ccs.tencentyun.com/library/node:22-bookworm AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN DEMO_BASE_PATH=/waveform-analysis/ pnpm build:demo && git rev-parse HEAD > dist-demo/version.txt

FROM local/sub2api-cpa-converter:1bd8fb805d5d
USER root
RUN rm -rf /www
COPY --from=build /app/dist-demo /www
USER 65534:65534
