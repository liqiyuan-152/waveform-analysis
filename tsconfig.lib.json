{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "rootDir": "./src",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  },
  "include": [
    "src/index.ts",
    "src/native.ts",
    "src/vue.ts",
    "src/env.d.ts",
    "src/analysis.ts",
    "src/display.ts",
    "src/input-number.ts",
    "src/select.ts",
    "src/color-picker.ts",
    "src/pagination.ts",
    "src/modal.ts",
    "src/popup.ts"
  ]
}
