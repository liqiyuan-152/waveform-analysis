{
  "name": "waveform-analysis",
  "version": "0.2.1",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "native": [
        "dist/types/native.d.ts"
      ],
      "vue": [
        "dist/types/vue.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./native": {
      "types": "./dist/types/native.d.ts",
      "import": "./dist/native.js",
      "require": "./dist/native.cjs"
    },
    "./native/style.css": "./dist/native/style.css",
    "./vue": {
      "types": "./dist/types/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:lib && pnpm typecheck && pnpm build:demo:app",
    "build:wasm": "node scripts/prepare-wasm.mjs --force",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "node scripts/clean-types.mjs && vue-tsc -p tsconfig.lib.json && node scripts/prepare-package-types.mjs",
    "build:demo": "pnpm prepare:demo && pnpm build:demo:app",
    "preview": "pnpm --filter demo-app preview",
    "typecheck": "pnpm build:types && vue-tsc -b",
    "check:file-length": "node scripts/check-file-length.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:oxlint": "oxlint . --deny-warnings",
    "lint:all": "pnpm lint:oxlint && pnpm lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm prepare:demo && vitest run",
    "test:coverage": "pnpm build:lib --sourcemap --minify false && pnpm build:types && vitest run --coverage",
    "test:package": "node scripts/test-package.mjs",
    "prepack": "pnpm build",
    "prepare:wasm": "node scripts/prepare-wasm.mjs",
    "test:animation:browser": "node scripts/test-animation-browser.mjs",
    "check:native-boundary": "node scripts/check-native-boundary.mjs",
    "check:licenses": "node scripts/check-third-party-notices.mjs",
    "typecheck:examples": "vue-tsc -p examples/tsconfig.json",
    "build:demo:app": "pnpm --filter demo-app build",
    "prepare:demo": "pnpm build:lib && pnpm build:types"
  },
  "dependencies": {
    "@types/d3": "7.4.3",
    "d3": "^7.9.0"
  },
  "peerDependencies": {
    "vue": ">=3.2.33 <4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "oxlint": "1.77.0",
    "playwright": "1.56.1",
    "prettier": "3.9.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "terser": "5.51.2",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "vue-tsc": "3.3.7"
  },
  "packageManager": "pnpm@10.32.1",
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}
