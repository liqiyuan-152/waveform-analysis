FROM rust:1.95.0-bookworm AS wasm-tools
RUN rustup target add wasm32-unknown-unknown \
    && cargo install wasm-pack --version 0.14.0 --locked

FROM node:22-bookworm AS build
COPY --from=wasm-tools /usr/local/cargo /usr/local/cargo
COPY --from=wasm-tools /usr/local/rustup /usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup
ENV PATH="/usr/local/cargo/bin:${PATH}"

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY demo-app ./demo-app
COPY tests/package.json ./tests/package.json
COPY wasm ./wasm
COPY scripts ./scripts
COPY src ./src
COPY tsconfig.json tsconfig.app.json tsconfig.lib.json tsconfig.node.json vite.config.ts vite.lib.config.ts ./
COPY eslint.config.js .oxlintrc.json ./

RUN corepack enable \
    && corepack prepare pnpm@10.32.1 --activate \
    && pnpm install --frozen-lockfile \
    && pnpm prepare:wasm \
    && DEMO_BASE_PATH=/waveform-analysis/ pnpm build:demo
