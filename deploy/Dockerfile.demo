FROM node:22-bookworm AS build

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
COPY wasm ./wasm
COPY scripts ./scripts
COPY src ./src
COPY index.html tsconfig.json tsconfig.app.json tsconfig.lib.json tsconfig.node.json vite.config.ts vite.lib.config.ts ./
COPY eslint.config.js .oxlintrc.json ./

RUN corepack enable \
    && corepack prepare pnpm@10.32.1 --activate \
    && pnpm install --frozen-lockfile \
    && pnpm build:lib \
    && pnpm build:types \
    && DEMO_BASE_PATH=/waveform-analysis/ pnpm build:demo
